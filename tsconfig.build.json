{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": true,
    "rootDir": ".",
    "outDir": "lib"
  },
  "include": ["core/src/**/*.ts", "local-service/src/**/*.ts", "rhen-adapter/src/**/*.ts"]
}
