{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "core/**/*.ts",
    "local-service/**/*.ts",
    "rhen-adapter/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
